{
  "name": "ai-agent-seminar-session02",
  // 全回共通のイメージ（.devcontainer/image で管理）。Python・uv・Git・Docker CLI・教材の依存を固定版で含む。
  "image": "ghcr.io/cosmac-dev/ai-agent-seminar-devcontainer:1.0.0",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/session02",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "containerEnv": {
    "OPENAI_API_KEY": "${localEnv:CMC_OPENAI_API_KEY}"
  }
}
