{
  "name": "ai-agent-seminar-session07",
  // 全回共通のイメージ（.devcontainer/image で管理）。Python・uv・Git・Docker CLI・教材の依存を固定版で含む。
  "image": "ghcr.io/cosmac-dev/ai-agent-seminar-devcontainer:1.0.0",
  "workspaceFolder": "/workspaces/ai-agent-seminar/session07",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.extraPaths": [
          "${workspaceFolder}/src"
        ],
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "containerEnv": {
    "PYTHONPATH": "/workspaces/ai-agent-seminar/session07/src",
    "OPENAI_API_KEY": "${localEnv:CMC_OPENAI_API_KEY}"
  }
}
