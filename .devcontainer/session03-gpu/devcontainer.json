{
  "name": "ai-agent-seminar-session03 (NVIDIA GPU)",
  // NVIDIA GPU 用のイメージ（.devcontainer/image-gpu で管理）。Python・uv・Git・CUDA 版の torch・transformers などを固定版で含む。
  "image": "ghcr.io/cosmac-dev/ai-agent-seminar-devcontainer-gpu:1.1.0",
  // NVIDIA GPU を使う（ホストに NVIDIA のドライバーと、Docker から GPU を使う設定が必要）。
  "hostRequirements": {
    "gpu": true
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/session03",
  // ホストの Hugging Face のモデルを読み取り専用でマウントし、link-host-models.sh でコンテナのキャッシュから使えるようにする。
  // - ホストのディレクトリ: ホストで HF_HUB_CACHE を設定した場合。未設定ならディレクトリでない /dev/null をマウントする
  // - Docker のボリューム: 既定は ai-agent-seminar-hf-hub（なければ空で作られる）。ホストで HF_HUB_VOLUME を設定すると別のボリュームを使う
  "mounts": [
    "source=${localEnv:HF_HUB_CACHE:/dev/null},target=/mnt/host-hf-hub,type=bind,readonly",
    "source=${localEnv:HF_HUB_VOLUME:ai-agent-seminar-hf-hub},target=/mnt/hf-hub-volume,type=volume,readonly"
  ],
  "postStartCommand": "bash /workspaces/${localWorkspaceFolderBasename}/.devcontainer/session03-gpu/link-host-models.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "containerEnv": {
    "OPENAI_API_KEY": "${localEnv:CMC_OPENAI_API_KEY}",
    "HF_TOKEN": "${localEnv:CMC_HF_TOKEN}",
    // 第3回の vLLM・Ollama のサーバーの接続先（ホスト名）。コンテナにインストールした場合は使わない
    "VLLM_SERVER_HOST": "${localEnv:VLLM_SERVER_HOST:host.docker.internal}",
    "OLLAMA_SERVER_HOST": "${localEnv:OLLAMA_SERVER_HOST:host.docker.internal}"
  }
}
