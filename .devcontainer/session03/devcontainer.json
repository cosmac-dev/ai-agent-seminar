{
  "name": "ai-agent-seminar-session03",
  // 全回共通のイメージ（.devcontainer/image で管理）。Python・uv・Git・Docker CLI・教材の依存を固定版で含む。
  "image": "ghcr.io/cosmac-dev/ai-agent-seminar-devcontainer:1.0.0",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/session03",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "containerEnv": {
    "OPENAI_API_KEY": "${localEnv:CMC_OPENAI_API_KEY}",
    // 第3回の推論サーバーの接続先（ホスト名）。既定はコンテナ内（localhost）。コンテナの外のサーバーに接続する場合にホストで設定する
    "LLM_SERVER_HOST": "${localEnv:LLM_SERVER_HOST:localhost}",
    "OLLAMA_SERVER_HOST": "${localEnv:OLLAMA_SERVER_HOST:localhost}"
  }
}
