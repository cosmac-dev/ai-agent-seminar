{
  "name": "ai-agent-seminar-session04",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "workspaceFolder": "/workspaces/ai-agent-seminar/session04",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.extraPaths": [
          "${workspaceFolder}/src"
        ],
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "containerEnv": {
    "PYTHONPATH": "/workspaces/ai-agent-seminar/session04/src"
  },
  /*"remoteEnv": {
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}"
  },*/
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r /workspaces/ai-agent-seminar/.devcontainer/requirements.txt"
}
